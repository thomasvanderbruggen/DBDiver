<Application x:Class="DBDiver.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>
    <Application.Resources>
        <SolidColorBrush x:Key="QueryBuilderInnerJoinColorBrush" Color="#FACC15" />
        <SolidColorBrush x:Key="QueryBuilderLeftJoinColorBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="QueryBuilderRightJoinColorBrush" Color="#EC4899" />
        <SolidColorBrush x:Key="QueryBuilderFullJoinColorBrush" Color="#A855F7" />
    </Application.Resources>
</Application>
