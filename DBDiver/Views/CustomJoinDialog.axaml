<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DBDiver.Views.CustomJoinDialog"
        Title="Add Custom Join"
        Width="480" Height="240"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="16">
        <TextBlock Grid.Row="0" Text="Custom Join" FontSize="18" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,12" />
        <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0">
                <TextBlock Text="Source" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4" />
                <AutoCompleteBox x:Name="SourceColumnBox" PlaceholderText="Source column" FilterMode="Contains" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Bottom" Margin="8,0" Foreground="#64748B" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Target" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4" />
                <AutoCompleteBox x:Name="TargetColumnBox" PlaceholderText="Target column" FilterMode="Contains" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="PreviewText" Foreground="#94A3B8" Margin="0,0,0,14" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="Cancel" Width="88" />
            <Button x:Name="ConfirmButton" Content="Add Join" Width="100" Classes="accent" />
        </StackPanel>
    </Grid>
</Window>
