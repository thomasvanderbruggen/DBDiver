<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DBDiver.ViewModels"
        x:Class="DBDiver.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="680" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="*,Auto" Margin="16" TextElement.Foreground="{DynamicResource SettingsTextBrush}">
        <TabControl x:Name="LayoutTabControl" Grid.Row="0">
            <TabItem Header="Appearance">
                <ScrollViewer Margin="8">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Theme" Width="240" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeNameComboBox" Width="160" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedTheme}" />
                        </StackPanel>
                        <ItemsControl x:Name="ThemeColorList" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Layout Physics">
                <ScrollViewer Margin="8">
                    <StackPanel x:Name="LayoutPanel" Spacing="10" />
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Query Builder">
                <ScrollViewer Margin="8">
                    <StackPanel x:Name="QueryBuilderPanel" Spacing="10" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="ResetButton" Content="Reset Section" Foreground="{DynamicResource SettingsButtonTextBrush}" />
            <Button x:Name="SaveButton" Content="Save" Classes="accent" Foreground="{DynamicResource SettingsButtonTextBrush}" />
            <Button x:Name="CloseButton" Content="Close" Foreground="{DynamicResource SettingsButtonTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
