    "id": "query-014",
    "category": "nested-where",
    "split": "heldout",
    "expectedOutcome": "ok",
    "schema": "sales",
    "prompt": "Show the names of products that are either red with a list price over 1000, or black with a list price under 100.",
    "expected": {
      "version": 1,
      "select": { "distinct": false, "columns": [ { "table": "Product", "column": "Name" } ] },
      "from": ["Product"],
      "where": [
        {
          "type": "group",
          "children": [
            { "type": "condition", "table": "Product", "column": "Color", "comparator": "=", "value": ["Red"] },
            { "type": "condition", "table": "Product", "column": "ListPrice", "comparator": ">", "value": ["1000"], "operator": "AND" }
          ]
        },
        {
          "type": "group",
          "operator": "OR",
          "children": [
            { "type": "condition", "table": "Product", "column": "Color", "comparator": "=", "value": ["Black"] },
            { "type": "condition", "table": "Product", "column": "ListPrice", "comparator": "<", "value": ["100"], "operator": "AND" }
          ]
        }
      ],
      "groupBy": [],
      "orderBy": []
    },
    "notes": "Check this against how your DTO models groups: first node omits operator, a group carries the operator that joins it to the previous node, and the first child inside a group omits it."
  },
